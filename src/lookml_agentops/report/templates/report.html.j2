<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>lkagent diagnose {{ d.head.run_id }}</title>
<style>
:root {
  color-scheme: light;
  --surface: #fcfcfb; --surface-2: #f3f2ee; --border: #e2e0d9;
  --text: #0b0b0b; --text-2: #52514e; --muted: #7a7873;
  --series-1: #2a78d6; --series-2: #eb6834; --series-3: #1baf7a;
  --good: #0ca30c; --warning: #fab219; --serious: #ec835a; --critical: #d03b3b;
}
@media (prefers-color-scheme: dark) {
  :root:where(:not([data-theme="light"])) {
    color-scheme: dark;
    --surface: #1a1a19; --surface-2: #232321; --border: #3a3936;
    --text: #ffffff; --text-2: #c3c2b7; --muted: #9a998f;
    --series-1: #3987e5; --series-2: #d95926; --series-3: #199e70;
  }
}
:root[data-theme="dark"] {
  color-scheme: dark;
  --surface: #1a1a19; --surface-2: #232321; --border: #3a3936;
  --text: #ffffff; --text-2: #c3c2b7; --muted: #9a998f;
  --series-1: #3987e5; --series-2: #d95926; --series-3: #199e70;
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--surface); color: var(--text);
  font: 15px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; }
main { max-width: 1040px; margin: 0 auto; padding: 32px 16px 64px; }
h1 { font-size: 22px; margin: 0 0 4px; }
h2 { font-size: 17px; margin: 36px 0 12px; }
.meta { color: var(--text-2); font-size: 13px; }
code { font: 12.5px ui-monospace, SFMono-Regular, Menlo, monospace; }
td code { white-space: nowrap; }
.tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; margin-top: 20px; }
.tile { background: var(--surface-2); border: 1px solid var(--border); border-radius: 10px; padding: 14px 16px; }
.tile .k { color: var(--text-2); font-size: 13px; }
.tile .v { font-size: 30px; font-weight: 600; font-variant-numeric: tabular-nums; }
.tile .s { color: var(--muted); font-size: 12.5px; }
.table-wrap { overflow-x: auto; }
table { border-collapse: collapse; width: 100%; font-size: 13.5px; }
th, td { text-align: left; padding: 7px 10px; border-bottom: 1px solid var(--border); vertical-align: top; }
th { color: var(--text-2); font-weight: 600; }
td.n, th.n { text-align: right; font-variant-numeric: tabular-nums; }
.badge { display: inline-flex; align-items: center; gap: 5px; font-size: 12.5px; white-space: nowrap; }
.badge::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--c); }
.st-pass { --c: var(--good); } .st-degraded { --c: var(--warning); }
.st-fail, .st-error { --c: var(--critical); } .st-skipped { --c: var(--muted); } .st-drift { --c: var(--series-1); }
.cause { font-weight: 600; }
.note { background: var(--surface-2); border-left: 3px solid var(--warning); padding: 10px 14px; border-radius: 4px; }
ul.head { padding-left: 18px; }
h3 { font-size: 15px; margin: 22px 0 8px; }
.pill { display: inline-block; font-size: 12px; padding: 1px 8px; border-radius: 10px; background: var(--surface-2); border: 1px solid var(--border); }
svg.trend { width: 100%; max-width: 720px; height: auto; }
svg .grid { stroke: var(--border); stroke-width: 1; }
svg .tick { fill: var(--muted); font-size: 11px; }
svg .line { fill: none; stroke-width: 2; }
svg .line.s1, svg .dot.s1 { stroke: var(--series-1); } svg .dot.s1 { fill: var(--series-1); }
svg .line.s2, svg .dot.s2 { stroke: var(--series-2); } svg .dot.s2 { fill: var(--series-2); }
svg .line.s3, svg .dot.s3 { stroke: var(--series-3); } svg .dot.s3 { fill: var(--series-3); }
svg .dot { stroke: var(--surface) !important; stroke-width: 2; }
svg .hit { fill: transparent; }
svg .pt:hover .dot { r: 6; }
svg .direct { fill: var(--text-2); font-size: 12px; }
.legend { display: flex; gap: 16px; font-size: 13px; color: var(--text-2); margin: 4px 0 8px; }
.legend span::before { content: ""; display: inline-block; width: 14px; height: 2px; margin-right: 6px; vertical-align: middle; background: var(--c); }
footer { margin-top: 48px; color: var(--muted); font-size: 12.5px; }
</style>
</head>
<body>
<main>
<h1>lkagent diagnose · {{ d.head.run_id }}</h1>
<div class="meta">
  <code>{{ d.head.runner_version }}</code> · as_of {{ d.head.as_of }} · started {{ d.head.started_at }} UTC{% if d.head.label %} · {{ d.head.label }}{% endif %}
</div>
{% if d.result_only %}
<p class="note">This runner can't expose the explore, fields, or filters behind its answers. Tests were compared on <strong>results only</strong>, and structural checks were skipped.</p>
{% endif %}

<div class="tiles">
{% for a in d.agents %}
  <div class="tile">
    <div class="k">{{ a.agent }}</div>
    <div class="v">{{ "%.1f"|format(a.rate) }}%</div>
    <div class="s">{{ a.passed }} pass · {{ a.degraded }} degraded · {{ a.drift }} drift · {{ a.failed }} fail · {{ a.errors }} error</div>
  </div>
{% endfor %}
</div>

<h2>Pass rate by agent</h2>
<div class="table-wrap"><table>
<tr><th>Agent</th><th class="n">Overall</th><th class="n">Suite</th><th class="n">Generated</th><th class="n">Tests</th></tr>
{% for a in d.agents %}
<tr><td>{{ a.agent }}</td><td class="n">{{ "%.1f"|format(a.rate) }}%</td><td class="n">{{ "%.1f"|format(a.suite_rate) }}%</td><td class="n">{{ "%.1f"|format(a.generated_rate) }}%</td><td class="n">{{ a.total }}</td></tr>
{% endfor %}
</table></div>

{% if d.diagnosis %}
<h2>Why answers changed (vs {{ d.diagnosis.run_a }})</h2>
<ul class="head">{% for line in d.headline %}<li>{{ line }}</li>{% endfor %}</ul>
{% for g in d.owners %}
<h3>{{ g.owner }} <span class="pill">{{ g.total }}</span></h3>
<div class="table-wrap"><table>
<tr><th>Cause</th><th>Test</th><th>Before → after</th><th>Likely cause</th><th>Confidence</th></tr>
{% for cause, vs in g.by_cause.items() %}{% for v in vs %}
<tr><td class="cause">{{ cause }}</td><td><code>{{ v.agent }}/{{ v.test_id }}</code></td>
<td><span class="badge st-{{ v.before }}">{{ v.before }}</span> → <span class="badge st-{{ v.after }}">{{ v.after }}</span></td>
<td>{{ v.likely_cause or "" }}</td><td>{{ v.confidence }}</td></tr>
{% endfor %}{% endfor %}
</table></div>
{% endfor %}
{% if d.diagnosis.external_groups %}
<h3>External pattern</h3>
<ul class="head">{% for g in d.diagnosis.external_groups %}<li>{{ g.count }} × <code>{{ g.tag }}</code>: {{ g.hint }}</li>{% endfor %}</ul>
{% endif %}
{% endif %}

{% if d.drift %}
<h2>Data drift</h2>
<p class="note">{{ d.drift|length }} test(s): the expected answer itself moved, for example because of late-arriving refunds. These aren't agent regressions. Accept the new truth with <code>lkagent diagnose run --rebaseline</code>.</p>
{% endif %}

{% if d.degraded %}
<h2>Degraded: right result, wrong structure</h2>
<div class="table-wrap"><table>
<tr><th>Test</th><th>Why</th></tr>
{% for r in d.degraded %}<tr><td><code>{{ r.agent }}/{{ r.test_id }}</code></td><td>{{ r.details|join("; ") }}</td></tr>{% endfor %}
</table></div>
{% endif %}

{% if d.failing %}
<h2>Failing tests</h2>
<div class="table-wrap"><table>
<tr><th>Test</th><th>Status</th><th>Details</th></tr>
{% for r in d.failing %}<tr><td><code>{{ r.agent }}/{{ r.test_id }}</code></td><td><span class="badge st-{{ r.status }}">{{ r.status }}</span></td><td>{{ r.details|join("; ") }}</td></tr>{% endfor %}
</table></div>
{% endif %}

<h2>Spec adherence</h2>
{% set broken = d.elements|rejectattr("honored")|list %}
<p class="meta">{{ d.elements|length - broken|length }} of {{ d.elements|length }} spec elements honored.</p>
<div class="table-wrap"><table>
<tr><th>Element</th><th>Agent</th><th class="n">Passing tests</th><th>Status</th></tr>
{% for e in d.elements %}
<tr><td><code>{{ e.element }}</code></td><td>{{ e.agent }}</td><td class="n">{{ e.passing }}/{{ e.tests }}</td>
<td><span class="badge {{ 'st-pass' if e.honored else 'st-fail' }}">{{ 'honored' if e.honored else 'not honored' }}</span></td></tr>
{% endfor %}
</table></div>

{% if d.trend|length > 1 %}
<h2>Trend: last {{ d.trend|length }} runs</h2>
<div class="legend">{% for a in d.agents %}<span style="--c: var(--series-{{ loop.index0 % 3 + 1 }})">{{ a.agent }}</span>{% endfor %}</div>
{{ chart|safe }}
<div class="table-wrap"><table>
<tr><th>Run</th><th>Runner</th>{% for a in d.agents %}<th class="n">{{ a.agent }}</th>{% endfor %}</tr>
{% for p in d.trend %}
<tr><td>{{ p.run_id }}{% if p.label %} <span class="meta">({{ p.label }})</span>{% endif %}</td><td><code>{{ p.runner }}</code></td>
{% for a in d.agents %}<td class="n">{{ "%.1f"|format(p.rates.get(a.agent, 0)) }}%</td>{% endfor %}</tr>
{% endfor %}
</table></div>
{% endif %}

<footer>lkagent {{ version }} · summaries and query structure only, never row-level data.</footer>
</main>
</body>
</html>
